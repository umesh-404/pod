# Maintainer: umesh-404
# Pod for Arch Linux — built from the Tauri app in windows/, which runs on
# Windows and Linux alike.

pkgname=pod-git
_pkgname=pod
pkgver=0.1.0
pkgrel=1
pkgdesc="A temporary workspace at the top of your screen: drop files to convert, zip, resize or keep them"
arch=('x86_64' 'aarch64')
url="https://github.com/umesh-404/pod"
license=("MIT" "LicenseRef-pod-assets")
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'gtk-layer-shell'
  'libayatana-appindicator'
  'gst-plugins-base'
  'gst-plugins-good'
  'dbus'
  'xdg-utils'
  'hicolor-icon-theme'
)
optdepends=(
  'ffmpeg: convert video, audio and image formats'
)
makedepends=('git' 'cargo' 'nodejs' 'npm')
provides=("$_pkgname")
conflicts=("$_pkgname")
# makepkg's default LTO and debug flags make the Rust build very slow.
options=('!lto' '!debug')
source=("$_pkgname::git+https://github.com/umesh-404/pod.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  local v
  v=$(sed -n 's/^version = "\(.*\)"/\1/p' windows/Cargo.toml | head -1)
  printf "%s.r%s.%s" "$v" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$_pkgname/windows"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
  npm ci
}

build() {
  cd "$_pkgname/windows"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$PWD/target"
  # beforeBuildCommand builds the front end.
  npx tauri build --no-bundle
}

package() {
  cd "$_pkgname"
  install -Dm755 windows/target/release/pod "$pkgdir/usr/bin/pod"
  install -Dm644 linux/arch/pod.desktop "$pkgdir/usr/share/applications/io.github.umesh404.pod.desktop"
  install -Dm644 windows/src-tauri/icons/32x32.png "$pkgdir/usr/share/icons/hicolor/32x32/apps/pod.png"
  install -Dm644 windows/src-tauri/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/pod.png"
  install -Dm644 windows/src-tauri/icons/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/pod.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 LICENSE-ASSETS.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE-ASSETS.md"
}
